{
  "id": "multitudes-densidad",
  "version": "0.1.0",
  "locale": "es-CR",
  "jurisdiction": "global",
  "description": "Densidad de personas por zona en frames muestreados (modo imagen de SAM, sin límite de 16). No sigue individuos ni reconoce caras: solo cuántos, no quiénes.",
  "targets": [{ "prompt": "person", "class": "person" }],
  "sampling": { "fps": 1, "mode": "image_sample" },
  "geometry": {
    "zones": [
      { "id": "zone_1", "polygon": [[0.1, 0.4], [0.9, 0.4], [0.9, 0.95], [0.1, 0.95]], "area_m2": 25 }
    ],
    "lines": []
  },
  "metrics": ["persons_per_zone", "density_per_m2", "peak_density"],
  "density": {
    "point": "bbox_bottom_center",
    "smoothing_window_s": 5,
    "sustain_s": 10
  },
  "alerts": [
    {
      "id": "density_medium",
      "when": "density_per_m2 >= 4 SUSTAINED sustain_s",
      "severity": "medium",
      "message": "Density of {density_per_m2} people/m² in {zone} for {sustain_s} s"
    },
    {
      "id": "density_high",
      "when": "density_per_m2 >= 6 SUSTAINED sustain_s",
      "severity": "high",
      "message": "Critical density of {density_per_m2} people/m² in {zone}: open an exit or slow entry"
    }
  ],
  "voice": { "languages": ["es", "en"], "link_by": ["timestamp", "station"] },
  "report": {
    "template": "multitudes_evento_v1",
    "sections": ["resumen", "pico_por_zona", "alertas", "notas_campo", "limites"]
  },
  "privacy": {
    "blur": ["person"],
    "blur_target": "full_bbox",
    "store": "aggregates_only",
    "identity": false,
    "tracking": false,
    "blur_radius": 28
  },
  "station_defaults": {
    "station": "demo-multitudes",
    "local_tz_offset_hours": -6
  },
  "output": { "annotated_video": true, "blurred_video": true, "heatmap": true }
}
